# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True

# Google Sheets API Configuration
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Application Configuration  
LOG_LEVEL=INFO

# DigiKey API Configuration (order capture, feature 024)
#
# 1. Sign in at https://developer.digikey.com and create a Production App.
# 2. Subscribe it to "Product Information" and "Order Status".
#    (Do NOT subscribe to "Ordering" -- this app never places orders, and that
#    is the product that requires a DigiKey Credit account.)
# 3. The portal demands an OAuth callback URL. Use https://localhost -- it must
#    be HTTPS, and 2-legged auth never redirects a browser, so it is unused.
# 4. DIGIKEY_ACCOUNT_ID is your DigiKey customer/account number, shown on any
#    order confirmation or invoice. It is NOT a credential, but it is required:
#    a 2-legged token identifies the application rather than the customer, so
#    without this header every order call answers 400 "Account ID must not be 0".
#
# Leaving DIGIKEY_CLIENT_ID unset disables the DigiKey screens cleanly; every
# other part of the application is unaffected.
DIGIKEY_CLIENT_ID=your-digikey-client-id-here
DIGIKEY_CLIENT_SECRET=your-digikey-client-secret-here
DIGIKEY_ACCOUNT_ID=your-digikey-account-number-here
# Override to https://sandbox-api.digikey.com to work against the sandbox.
DIGIKEY_API_BASE=https://api.digikey.com

# Category taxonomy and specification vocabulary (feature 025)
#
# The application ships with one workshop's taxonomy -- the branches in
# docs/category-taxonomy.md -- offered as suggestions when filing a product, so
# that a branch nobody has filed into yet can still be picked instead of typed
# from memory. Those branches are somebody else's shop. Point these at your own
# JSON to replace them.
#
# Each file is a JSON array of strings, and nothing else:
#
#   CATEGORY_TAXONOMY_FILE   ["electronics", "electronics/sensors", "fasteners/nuts"]
#   SPECIFICATION_KEYS_FILE  ["Thread", "Length", "Voltage"]
#
# Parent branches are filled in for you, so listing "a/b/c" also offers "a" and
# "a/b". Paths are lowercased and may nest as deep as you like.
#
# An override REPLACES the built-in list rather than adding to it. The two are
# independent: set one and the other keeps its default.
#
# Leave both unset and nothing is read from disk. If a file is set but cannot be
# read, parsed or validated, the application refuses to start and says why --
# quietly falling back would file your products under another shop's branches.
#CATEGORY_TAXONOMY_FILE=/etc/workshop-inventory/categories.json
#SPECIFICATION_KEYS_FILE=/etc/workshop-inventory/specification-keys.json
