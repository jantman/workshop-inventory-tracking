# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True

# Google Sheets API Configuration
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Application Configuration
LOG_LEVEL=INFO

# GS1 internal-identifier grammar (Story 2.4). Together these define the element
# string printed on every internal label and recognized by every scan:
# <FNC1><AI><TOKEN><internal_id>. Changing either moves the encoder and the scan
# router together, with no code change — but it invalidates every label already
# applied to a physical part, so treat them as frozen once labels are printed.
# Defaults shown. Leaving either blank or unset falls back to the default; a
# value that is set but malformed (surrounding or interior whitespace, a control
# or non-ASCII character) is NOT repaired — it raises on the first encode, so a
# typo here surfaces at the label printer rather than silently malforming
# symbols.
GS1_INTERNAL_AI=96
GS1_INTERNAL_TOKEN=WIT

# Ownership / return information printed on internal labels (Story 2.5). This is
# HUMAN-READABLE label text and nothing else: it is printed as plain text beside
# the barcode and is never encoded into the symbol. What guarantees that is
# structural — no code path passes this value to the encoder at all — and not a
# property of the text you put here: a typical return-to string happens to be
# unencodable because it carries spaces, but a short compact one such as
# ReturnTo:J.Antman would encode perfectly well if something handed it over.
# Separately, GS1's logistics AIs (the 43xx series) are where such data would
# conventionally be carried machine-readably, and this system refuses to build
# any element string under them; that is a guarantee about the AI, not about
# this text. Leaving it blank or unset is a valid configuration and means no
# ownership region — it is not an error, and it is why this ships blank rather
# than with a sample: a copied-and-forgotten placeholder would be printed on
# real parts. Surrounding whitespace is trimmed. No length limit is imposed
# here; where the text lands on the label, and how it wraps, belongs to the
# label-rendering epic. Quote the value if it contains a '#' — python-dotenv
# treats an unquoted ' #' as the start of a comment and would silently drop the
# rest of the line, e.g. LABEL_OWNER_TEXT='J. Antman, Unit #3'
LABEL_OWNER_TEXT=
