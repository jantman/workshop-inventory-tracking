{
  "manifest_version": 3,
  "name": "Workshop Capture",
  "description": "Capture a vendor listing or order into Workshop Inventory Tracking.",
  "version": "2.0.0",
  "permissions": [
    "scripting",
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Capture to Workshop",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
